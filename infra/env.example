# Example environment for the dedicated MCP HTTP host.
# Copy to /srv/mcp-air/.env and fill secrets. Do not commit real values.

AIR_API_URL=https://api.air.thalus.ai
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=4104
MCP_HTTP_PATH=/mcp

# OAuth introspection client registered against air-api (DCR or seeded).
OAUTH_INTROSPECT_CLIENT_ID=
OAUTH_INTROSPECT_CLIENT_SECRET=

# Redis on the MCP server only (not shared with main AIR stack).
REDIS_URL=redis://127.0.0.1:6379
